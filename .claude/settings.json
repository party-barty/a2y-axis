{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-lint.sh\"",
            "timeout": 120,
            "statusMessage": "Pre-commit lint+typecheck…"
          }
        ]
      }
    ]
  }
}
